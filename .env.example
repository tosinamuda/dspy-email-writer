# Copy to .env. Only secrets and machine-specific choices belong here;
# models, budgets, and thresholds live in email_writer/config.py.

# Which entry of PROVIDERS in email_writer/config.py to use: openai or ollama.
LLM_PROVIDER=openai

# Needed only when LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-...
