# Copy this file to .env. These values override src/config.py.
#   cp .env.example .env

# Local models, through ollama. No key needed.
TASK_MODEL=ollama_chat/qwen3:4b
REFLECTION_MODEL=ollama_chat/gpt-oss:20b
API_BASE=http://localhost:11434

# OpenAI instead. Delete the three lines above, then uncomment these.
# TASK_MODEL=openai/gpt-5-mini
# REFLECTION_MODEL=openai/gpt-5
# API_BASE=
# OPENAI_API_KEY=sk-...

# Short GEPA run. Use a value above the eval set size, or GEPA proposes nothing.
# MAX_METRIC_CALLS=40
